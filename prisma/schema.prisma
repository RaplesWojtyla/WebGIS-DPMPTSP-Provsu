generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  role          Role         @default(user)
  suspended     Boolean      @default(false)
  suspendedAt   DateTime?
  accounts      Account[]
  sessions      Session[]
  profile       UserProfile?
  proposals     Proposal[]

  @@map("user")
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  fullName        String?
  nik             String?
  gender          String?  @default("Laki-laki")
  placeOfBirth    String?
  dateOfBirth     String?
  phone           String?
  jobTitle        String?
  companyName     String?
  companyType     String?  @default("PT")
  nib             String?
  npwpCompany     String?
  establishedYear String?
  capitalSource   String?  @default("PMDN")
  address         String?
  province        String?  @default("Sumatera Utara")
  regencyId       String?
  postalCode      String?
  isComplete      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  token     String   @unique
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Province {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  regencies Regency[]
}

model Regency {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  provinceId  String
  districts   District[]
  province    Province     @relation(fields: [provinceId], references: [id])
  investments Investment[]
  pdrbValues  PdrbValue[]
  proposals   Proposal[]
}

model District {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  regencyId String
  regency   Regency   @relation(fields: [regencyId], references: [id])
  villages  Village[]
}

model Village {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  districtId String
  district   District @relation(fields: [districtId], references: [id])
}

model Sector {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  nameEn      String?
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  investments Investment[]
  pdrbValues  PdrbValue[]
  proposals   Proposal[]

  @@map("sector")
}

model PdrbValue {
  id          String     @id @default(cuid())
  value       Float
  year        Int
  regencyId   String
  sectorId    String
  status      PdrbStatus @default(PENDING)
  submittedAt DateTime?
  approvedAt  DateTime?
  approvedBy  String?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  regency     Regency    @relation(fields: [regencyId], references: [id])
  sector      Sector     @relation(fields: [sectorId], references: [id])

  @@unique([regencyId, sectorId, year])
  @@map("pdrb_value")
}

model Investment {
  id        String   @id @default(cuid())
  value     Float
  year      Int
  regencyId String
  sectorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  regency   Regency  @relation(fields: [regencyId], references: [id])
  sector    Sector   @relation(fields: [sectorId], references: [id])

  @@unique([regencyId, sectorId, year])
  @@map("investment")
}

enum Role {
  user
  admin
  operator
}

enum PdrbStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProposalType {
  INVESTMENT
  LAND_OFFER
}

enum ProposalStatus {
  SUBMITTED
  VERIFIED
  REVISION
  APPROVED
  REJECTED
}

model Proposal {
  id     String         @id @default(cuid())
  type   ProposalType
  status ProposalStatus @default(SUBMITTED)
  userId String

  // Shared fields
  title       String
  sectorId    String?
  regencyId   String?
  description String?

  // Investment-specific
  permitType      String?
  investmentValue Float?
  capitalSource   String?
  workforcePlan   Int?
  locationAddress String?
  locationLat     Float?
  locationLng     Float?
  landArea        Float?

  // Land-offer-specific
  assetType       String?
  offerPrice      Float?
  transactionType String?

  // Review
  operatorNotes String?
  verifiedAt    DateTime?
  verifiedBy    String?
  adminNotes    String?
  approvedAt    DateTime?
  approvedBy    String?
  rejectedAt    DateTime?
  rejectedBy    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector  Sector?  @relation(fields: [sectorId], references: [id])
  regency Regency? @relation(fields: [regencyId], references: [id])

  @@map("proposal")
}
